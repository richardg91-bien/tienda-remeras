# Copiar este archivo como .env y completar con los valores reales
# cp .env.example .env

# ── Servidor ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── URLs ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# ── Supabase ──────────────────────────────────────────────
# Supabase Dashboard → Settings → API
SUPABASE_URL=https://TU_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...TU_SERVICE_ROLE_KEY

# ── JWT ───────────────────────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GENERAR_CLAVE_64_CHARS
JWT_REFRESH_SECRET=GENERAR_OTRA_CLAVE_64_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── MercadoPago ───────────────────────────────────────────
# https://www.mercadopago.com.ar/developers/panel/app
MP_TOKEN=tu_access_token_real

# ── Cloudinary ────────────────────────────────────────────
# https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
