{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "anathel-workers-cpu-lab",
  "main": "src/cpu-preview.mjs",
  "compatibility_date": "2026-11-26",
  "preview_urls": true,
  "observability": {
    "enabled": false
  },
  "previews": {
    "vars": {
      "LAB_MODE": "cpu-preview-only"
    },
    "observability": {
      "enabled": true,
      "logs": {
        "enabled": true,
        "invocation_logs": true,
        "persist": true
      },
      "traces": {
        "enabled": true,
        "head_sampling_rate": 1,
        "persist": true
      }
    }
  }
}
