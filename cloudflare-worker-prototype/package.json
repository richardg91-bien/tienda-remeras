{
  "name": "neon-stitch-cloudflare-worker-prototype",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --config wrangler.jsonc --port 8787 --persist-to .wrangler/phase1c-state",
    "migrate:local": "wrangler d1 migrations apply anathel-mvp-local --local --config wrangler.jsonc --persist-to .wrangler/phase1c-state",
    "test:local": "powershell -NoProfile -ExecutionPolicy Bypass -File ./test-local-mvp.ps1",
    "test:api-local": "node test-local.mjs",
    "test:restart-local": "node test-persistence-after-restart.mjs",
    "profile:bcrypt": "node profile-bcrypt.mjs",
    "dev:pg-local": "wrangler dev --local --config wrangler.pg-lab.jsonc --port 8788",
    "test:pg-local": "node test-pg-local.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mercadopago": "^3.4.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "wrangler": "^4.44.0"
  }
}
